{
  "openapi": "3.1.0",
  "info": {
    "title": "Repost Manager API",
    "version": "1.0.0",
    "description": "Contract for admin and public surfaces (ADR-0003)."
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ],
  "tags": [
    { "name": "system" },
    { "name": "admin" },
    { "name": "public" }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["system"],
        "summary": "Health check",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Service is up",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": { "type": "string" },
                  "example": { "status": "ok" }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/auth/login": {
      "post": {
        "tags": ["admin"],
        "summary": "Admin login",
        "description": "Authenticates with email/password. Returns access JWT; sets refresh cookie.",
        "operationId": "adminLogin",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TokenResponse" }
              }
            }
          },
          "401": { "description": "Invalid credentials" },
          "429": { "description": "Rate limited" }
        }
      }
    },
    "/api/v1/admin/auth/refresh": {
      "post": {
        "tags": ["admin"],
        "summary": "Refresh access token",
        "operationId": "adminRefresh",
        "responses": {
          "200": {
            "description": "New access token",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TokenResponse" }
              }
            }
          },
          "401": { "description": "Missing or invalid refresh cookie" },
          "429": { "description": "Rate limited" }
        }
      }
    },
    "/api/v1/admin/auth/logout": {
      "post": {
        "tags": ["admin"],
        "summary": "Admin logout",
        "operationId": "adminLogout",
        "responses": {
          "204": { "description": "Logged out" }
        }
      }
    },
    "/api/v1/admin/posts": {
      "get": {
        "tags": ["admin"],
        "summary": "List admin posts",
        "operationId": "listAdminPosts",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "enum": ["draft", "scheduled", "published"] }
          }
        ],
        "responses": {
          "200": {
            "description": "Posts for the default blog",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PostListResponse" }
              }
            }
          },
          "401": { "description": "Missing or invalid Bearer JWT" }
        }
      },
      "post": {
        "tags": ["admin"],
        "summary": "Create post",
        "operationId": "createAdminPost",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpsertPostRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PostResponse" }
              }
            }
          },
          "400": { "description": "Validation error" },
          "401": { "description": "Missing or invalid Bearer JWT" },
          "409": { "description": "Slug already exists" }
        }
      }
    },
    "/api/v1/admin/posts/{id}": {
      "get": {
        "tags": ["admin"],
        "summary": "Get post by id",
        "operationId": "getAdminPost",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Post",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PostResponse" }
              }
            }
          },
          "401": { "description": "Missing or invalid Bearer JWT" },
          "404": { "description": "Not found" }
        }
      },
      "put": {
        "tags": ["admin"],
        "summary": "Update post",
        "operationId": "updateAdminPost",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpsertPostRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PostResponse" }
              }
            }
          },
          "400": { "description": "Validation error" },
          "401": { "description": "Missing or invalid Bearer JWT" },
          "404": { "description": "Not found" },
          "409": { "description": "Slug already exists" }
        }
      },
      "delete": {
        "tags": ["admin"],
        "summary": "Delete post",
        "operationId": "deleteAdminPost",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "204": { "description": "Deleted" },
          "401": { "description": "Missing or invalid Bearer JWT" },
          "404": { "description": "Not found" }
        }
      }
    },
    "/api/v1/admin/": {
      "get": {
        "tags": ["admin"],
        "summary": "Admin API surface",
        "description": "Stub endpoint for the authenticated admin surface.",
        "operationId": "getAdminSurface",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Surface metadata",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": { "type": "string" },
                  "example": { "surface": "admin", "version": "v1" }
                }
              }
            }
          },
          "401": { "description": "Missing or invalid Bearer JWT" }
        }
      }
    },
    "/api/v1/public/posts": {
      "get": {
        "tags": ["public"],
        "summary": "List published posts",
        "operationId": "listPublicPosts",
        "responses": {
          "200": {
            "description": "Published posts",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PublicPostListResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/public/posts/{slug}": {
      "get": {
        "tags": ["public"],
        "summary": "Get published post by slug",
        "operationId": "getPublicPostBySlug",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Published post",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PublicPostResponse" }
              }
            }
          },
          "404": { "description": "Missing or not published" }
        }
      }
    },
    "/api/v1/public/": {
      "get": {
        "tags": ["public"],
        "summary": "Public API surface",
        "description": "Stub endpoint for the anonymous, cacheable public surface.",
        "operationId": "getPublicSurface",
        "responses": {
          "200": {
            "description": "Surface metadata",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": { "type": "string" },
                  "example": { "surface": "public", "version": "v1" }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "format": "password" }
        }
      },
      "TokenResponse": {
        "type": "object",
        "required": ["accessToken", "tokenType", "expiresIn"],
        "properties": {
          "accessToken": { "type": "string" },
          "tokenType": { "type": "string", "default": "Bearer" },
          "expiresIn": { "type": "integer", "format": "int64" }
        }
      },
      "PostResponse": {
        "type": "object",
        "required": [
          "id",
          "blogId",
          "slug",
          "title",
          "contentMd",
          "status",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "blogId": { "type": "string", "format": "uuid" },
          "slug": { "type": "string" },
          "title": { "type": "string" },
          "excerpt": { "type": "string", "nullable": true },
          "contentMd": { "type": "string" },
          "coverMediaId": { "type": "string", "format": "uuid", "nullable": true },
          "status": { "type": "string", "enum": ["draft", "scheduled", "published"] },
          "publishedAt": { "type": "string", "nullable": true },
          "readingTime": { "type": "integer", "nullable": true },
          "createdAt": { "type": "string" },
          "updatedAt": { "type": "string" }
        }
      },
      "UpsertPostRequest": {
        "type": "object",
        "required": ["slug", "title"],
        "properties": {
          "slug": { "type": "string" },
          "title": { "type": "string" },
          "excerpt": { "type": "string", "nullable": true },
          "contentMd": { "type": "string", "default": "" },
          "status": {
            "type": "string",
            "enum": ["draft", "scheduled", "published"],
            "default": "draft"
          },
          "publishedAt": { "type": "string", "nullable": true }
        }
      },
      "PostListResponse": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/PostResponse" }
          }
        }
      },
      "PublicPostResponse": {
        "type": "object",
        "required": ["id", "slug", "title", "contentMd", "updatedAt"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "slug": { "type": "string" },
          "title": { "type": "string" },
          "excerpt": { "type": "string", "nullable": true },
          "contentMd": { "type": "string" },
          "coverMediaId": { "type": "string", "format": "uuid", "nullable": true },
          "publishedAt": { "type": "string", "nullable": true },
          "readingTime": { "type": "integer", "nullable": true },
          "updatedAt": { "type": "string" }
        }
      },
      "PublicPostListResponse": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/PublicPostResponse" }
          }
        }
      }
    }
  }
}
